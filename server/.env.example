# คัดลอกเป็น server/.env แล้วแก้ค่า — ไฟล์ .env อยู่ใน .gitignore แล้ว

# ---------- บัญชีผู้ดูแลคนแรก ----------
# ใช้ตอนตาราง users ยังว่างเท่านั้น ถ้าไม่ตั้ง ระบบจะสุ่มรหัสให้แล้วพิมพ์ใน log ตอน start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- production ----------
# เปิดเมื่ออยู่หลัง HTTPS — ถ้าเปิดตอนรันบน http เบราว์เซอร์จะไม่ส่ง cookie กลับมาและล็อกอินไม่ติด
SECURE_COOKIE=0

# โดเมนของหน้าเว็บ (คั่นด้วย , ได้) — ตั้งเมื่อ frontend อยู่คนละ origin กับ API
# ถ้าเสิร์ฟหน้าเว็บจาก origin เดียวกันอยู่แล้ว ไม่ต้องตั้ง
CORS_ORIGIN=

PORT=8787

# ---------- ฟีเจอร์ AI (ไม่บังคับ) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
